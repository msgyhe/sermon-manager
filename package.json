{
  "name": "sermon-manager",
  "description": "설교문과 기도문을 작성하고 예배별로 관리하는 개인용 사역 작업실",
  "author": "Word and Prayer",
  "private": true,
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/msgyhe/sermon-manager.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "docx": "latest",
    "electron-updater": "^6.8.9",
    "jszip": "latest",
    "lucide-react": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "kr.church.wordandprayer",
    "productName": "말씀과 기도",
    "directories": {
      "output": "${env.TEMP}/sermon-manager-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "msgyhe",
        "repo": "sermon-manager",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "sermon-manager-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
